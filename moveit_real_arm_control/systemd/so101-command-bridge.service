[Unit]
Description=SO-ARM101 MoveIt command bridge (FollowJointTrajectory action -> UDP)
After=network-online.target zenoh-router.service
Wants=network-online.target zenoh-router.service

[Service]
Type=simple
WorkingDirectory=/root/lerobot_project
Environment=ROS_HOME=/root/.ros
Environment=ROS_LOG_DIR=/root/.ros/log
ExecStart=/root/lerobot_project/start_so101_command_bridge.sh
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
