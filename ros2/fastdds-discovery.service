[Unit]
Description=Fast DDS discovery server for Atlas and WSL ROS 2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec fastdds discovery -i 0 -l 192.168.0.2 -p 11811'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
