[Unit]
Description=Read-only SO-ARM101 joint state bridge for RViz2
After=network-online.target zenoh-router.service
Wants=network-online.target zenoh-router.service

[Service]
Type=simple
WorkingDirectory=/root/lerobot_project
Environment=ROS_HOME=/root/.ros
Environment=ROS_LOG_DIR=/root/.ros/log
ExecStart=/root/lerobot_project/start_so101_rviz_bridge.sh --fps 20
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
