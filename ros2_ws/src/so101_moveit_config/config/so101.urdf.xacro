<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_new_calib">
  <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>

  <xacro:include filename="$(find so101_description)/urdf/so101.urdf"/>
  <xacro:include filename="so101.ros2_control.xacro"/>

  <xacro:so101_ros2_control
    name="SO101MockSystem"
    initial_positions_file="$(arg initial_positions_file)"/>
</robot>
