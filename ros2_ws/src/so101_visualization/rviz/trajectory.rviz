Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.05
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: SO-ARM101
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.08
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Buffer Length: 600
      Class: rviz_default_plugins/Path
      Color: 255; 85; 255
      Enabled: true
      Head Diameter: 0.02
      Head Length: 0.04
      Name: EE Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.01
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ee_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: EE Trail
      Namespaces:
        circle: true
        current: true
        tip: true
        stats: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ee_trail
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Workspace Boundary
      Namespaces:
        boundary: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dt_boundary
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Forbidden Zones
      Namespaces:
        forbidden: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dt_forbidden
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Joint Angle Labels
      Namespaces:
        joint_labels: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dt_joint_labels
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Located Object
      Namespaces:
        object: true
        object_text: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /located_object
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.65
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.18
      Name: Current View
      Pitch: 0.45
      Target Frame: base_link
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
